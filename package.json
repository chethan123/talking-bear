{
  "name": "talking-bear",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:dist": "node scripts/check-dist.mjs dist production",
    "preview": "vite preview --port 4173 --strictPort",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4173 --strictPort",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run --project node --project worklet",
    "test:coverage": "vitest run --project node --project worklet --coverage",
    "test:browser": "vitest run --project browser",
    "e2e": "pnpm build:e2e && playwright test",
    "fixtures": "node scripts/gen-fixtures.ts",
    "corpus": "node scripts/gen-corpus.ts",
    "gen:bear": "node scripts/gen-bear-parts.ts",
    "gen:vad-fingerprint": "node scripts/gen-vad-fingerprint.ts",
    "silero:fetch": "node scripts/fetch-silero-onnx.ts",
    "silero:extract": "node scripts/extract-silero-weights.ts",
    "parity": "node scripts/fetch-silero-onnx.ts && node scripts/silero-parity.ts",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/audioworklet": "0.0.100",
    "@types/node": "24.19.0",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "fast-check": "4.10.2",
    "onnxruntime-web": "1.30.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "workbox-window": "7.4.1"
  }
}
