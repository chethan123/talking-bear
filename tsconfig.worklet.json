{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worklet.tsbuildinfo",
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["audioworklet"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.worklet.ts", "src/dsp/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.browser.test.ts"],
  // Keeps `tsc -b` from failing with TS18003 (no inputs) before the first worklet or src/dsp file exists.
  "references": []
}
