{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["docs/research/**", "dist*/**", "coverage/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "no-underscore-dangle": ["warn", { "allow": ["__cspViolations", "__bearTest"] }]
  }
}
